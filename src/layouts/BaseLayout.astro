---
import type { Lang } from '../i18n/ui';
import type { RouteKey } from '../i18n/utils';
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description?: string;
}

const { lang, route, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href="/images/a.png" />
  </head>
  <body>
    <Navbar lang={lang} route={route} />
    <main>
      <slot />
    </main>
  </body>
</html>
