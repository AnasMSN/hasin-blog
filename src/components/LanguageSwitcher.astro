---
import { languages, type Lang } from '../i18n/ui';
import { getLocalizedRoute, type RouteKey } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: RouteKey;
}

const { lang, route } = Astro.props;
const langCodes = Object.keys(languages) as Lang[];
---

<label class="lang-switcher">
  <span class="sr-only">Language</span>
  <select id="lang-select">
    {
      langCodes.map((code) => (
        <option value={getLocalizedRoute(code, route)} selected={code === lang}>
          {languages[code]}
        </option>
      ))
    }
  </select>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>('#lang-select').forEach((select) => {
    select.addEventListener('change', () => {
      window.location.href = select.value;
    });
  });
</script>
