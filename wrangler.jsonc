{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hasin-site",
  "compatibility_date": "2026-04-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hasin-site-db",
      "database_id": "fa323fd9-d139-413a-acf5-aae251d6de86"
    }
  ],
  "r2_buckets": [
    {
      "binding": "POST_IMAGES",
      "bucket_name": "hasin-site-images"
    }
  ]
}
